{
  "manifest_version": 3,
  "name": "ClearGem",
  "version": "1.1.1",
  "description": "Automatically removes visible Gemini AI watermarks via reverse alpha blending. Zero-click.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "host_permissions": [
    "*://*.googleusercontent.com/*",
    "*://*.google.com/*",
    "*://*.google/*",
    "*://*.vertex.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://console.cloud.google.com/*",
        "https://labs.google/*",
        "https://labs.google.com/*",
        "https://imagegeneration.vertex.ai/*"
      ],
      "js": ["intercept.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://console.cloud.google.com/*",
        "https://labs.google/*",
        "https://labs.google.com/*",
        "https://imagegeneration.vertex.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "cleargem@sysadmindoc",
      "strict_min_version": "109.0"
    }
  }
}
